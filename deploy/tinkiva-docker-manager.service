[Unit]
Description=Tinkiva Docker Manager
Documentation=file:/usr/local/share/doc/tinkiva-docker-manager/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tinkiva-docker
Group=tinkiva-docker
SupplementaryGroups=docker
EnvironmentFile=/etc/tinkiva-docker-manager/env
Environment=HOME=/var/lib/tinkiva-docker-manager
ExecStart=/usr/local/bin/tmanager
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
UMask=0027

# El usuario pertenece al grupo docker; eso equivale a privilegios de root sobre el host.
# Estas directivas reducen exposición accidental, pero no convierten Docker en un sandbox.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tinkiva-docker-manager /opt/tinkiva/apps
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
TasksMax=96

[Install]
WantedBy=multi-user.target
